# Supabase > Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional Cloudflare Turnstile site key; also configure its secret in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Demo local only. Keep false in production.
NEXT_PUBLIC_DEMO_MODE=false

# New uploads: supabase (default) or google-drive. Legacy Supabase files remain readable.
NEXT_PUBLIC_STORAGE_PROVIDER=supabase
# Server ONLY. Never prefix these with NEXT_PUBLIC_.
# Use the service_role JWT or secret key from Supabase server API settings.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical URL, without a trailing path. Use http://localhost:3000 for local setup.
APP_URL=https://romeoharofotografia.org
# Supabase Auth UUID of the single photographer who owns this dedicated Drive.
GOOGLE_DRIVE_OWNER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Generate locally: openssl rand -base64 32 (keep unchanged after connecting).
DRIVE_ENCRYPTION_KEY=
